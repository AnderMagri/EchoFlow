{
  "manifest_version": 3,
  "name": "EchoFlow",
  "version": "1.6.0",
  "description": "UX audit tool for websites — Generic UX, Shopify, Fintech, Crypto verticals with mobile analysis, Shopify Migration, and FigJam/Notion export.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "offscreen",
    "debugger",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "action": {
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "results.html",
        "sidebar.html",
        "offscreen.html",
        "knowledge-base/generic-ux.json",
        "knowledge-base/mobile.json",
        "knowledge-base/shopify.json",
        "knowledge-base/fintech.json",
        "knowledge-base/crypto.json",
        "knowledge-base/shopify-adapt/themes.json",
        "knowledge-base/shopify-adapt/sections.json",
        "knowledge-base/shopify-adapt/components.json",
        "knowledge-base/shopify-adapt/platform.json",
        "knowledge-base/shopify-adapt/migration-patterns.json"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:;"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
